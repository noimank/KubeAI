# KubeAI Backend Configuration
APP_NAME=KubeAI
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api

# PostgreSQL (NodePort 30432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:30432/kubeai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (NodePort 30379)
REDIS_URL=redis://localhost:30379/0
REDIS_MAX_CONNECTIONS=20
TASKIQ_BROKER_DB=1
TASKIQ_RESULT_BACKEND_DB=2
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=10
INFERENCE_SERVICE_STATUS_SYNC_INTERVAL_SECONDS=60
TRAINING_JOB_STATUS_SYNC_INTERVAL_SECONDS=60

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# 开发环境空闲检测
DEV_ENV_IDLE_TIMEOUT_MINUTES=60
DEV_ENV_IDLE_CHECK_INTERVAL_SECONDS=300

# 身份/租户缓存 TTL (秒)
IDENTITY_CACHE_TTL_SECONDS=300
TENANT_STATUS_CACHE_TTL_SECONDS=120

# 资源清理 (已完成训练任务的 Pod 清理)
RESOURCE_CLEANUP_ENABLED=true
RESOURCE_CLEANUP_INTERVAL_SECONDS=3600
RESOURCE_CLEANUP_JOB_MAX_AGE_DAYS=7

# 是否允许自行注册账号 true / false
ALLOW_USER_REGISTRATION=true

# OIDC / OAuth2 (optional — leave disabled for built-in auth only)
# 对接 Casdoor 时：需要在 Casdoor 应用中创建 kubeai_ 前缀的角色（kubeai_admin/mlops/engineer/annotator）
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES='openid profile email'
OIDC_DISPLAY_NAME='SSO 登录'
OIDC_AUTO_REDIRECT=false
FRONTEND_URL=http://localhost:3000

# MinIO (保留兼容; 模型存储已改为本地文件系统 MODEL_BASE_PATH, 此处不再被模型链路使用)
# MinIO (NodePort 30900)
MINIO_ENDPOINT=localhost:30900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=kubeai-models-

# 数据集文件存储路径 (Pod 内挂载路径)
DATASET_BASE_PATH=/data/kubeai/datasets

# 模型文件本地存储路径 (Pod 内挂载路径, 模拟 S3 bucket/object 层级; backend/worker 同节点共享)
MODEL_BASE_PATH=/data/kubeai/models

# 算法文件本地存储路径
ALGORITHM_BASE_PATH=/data/kubeai/algorithms

# Harbor
HARBOR_URL=http://harbor.kubeai.local
HARBOR_USERNAME=admin
HARBOR_PASSWORD=Harbor12345
HARBOR_PROJECT_PREFIX=kubeai-

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# MLflow (必选基础依赖; 训练任务可选择是否启用, 通过创建任务表单的 "实验追踪" 开关)
MLFLOW_TRACKING_URI=http://localhost:5000

# LabelStudio (NodePort 30800)
LABEL_STUDIO_URL=http://localhost:30800
LABEL_STUDIO_API_TOKEN=

# Native Pod 开发环境 — APISIX Admin API 动态路由
# 路由 /devenv/<uuid_hex>/ 与主应用共用域名，本地 Vite proxy 到 APISIX

# APISIX Admin API 地址 (backend 创建/删除环境时调用)
#   生产: http://kubeai-apisix-admin.kubeai.svc.cluster.local:9180
#   本地: http://127.0.0.1:30918 (NodePort)
KUBEAI_APISIX_ADMIN_URL=http://kubeai-apisix-admin.kubeai.svc.cluster.local:9180

# APISIX Admin API 密钥 (默认值，生产环境务必修改)
KUBEAI_APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# APISIX forward-auth 回源验证地址 (K8s 集群内部可达的后端)
#   生产: http://backend.kubeai.svc.cluster.local:8000
#   本地: http://host.docker.internal:8000
KUBEAI_BACKEND_INTERNAL_URL=http://backend.kubeai.svc.cluster.local:8000

# K8s 平台命名空间
K8S_PLATFORM_NAMESPACE=kubeai

# 容器工具镜像 (按需修改为私有仓库地址)
KANIKO_IMAGE=gcr.io/kaniko-project/executor:latest
MINIO_MC_IMAGE=minio/mc:latest
BUSYBOX_IMAGE=busybox:1.36

# TensorBoard sidecar 镜像与端口 (由 build_vcjob 注入到 trainer Pod)
# 训练任务创建时勾选 "TensorBoard 可视化" 即注入该 sidecar
TENSORBOARD_IMAGE=kubeai-tensorboard:latest
TENSORBOARD_PORT=6006
