# KubeAI Backend Configuration
APP_NAME=KubeAI
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kubeai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# OIDC / OAuth2 (optional — leave disabled for built-in auth only)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES='openid profile email'
OIDC_DISPLAY_NAME='SSO 登录'
FRONTEND_URL=http://localhost:3000

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=kubeai-datasets-

# Harbor
HARBOR_URL=http://harbor.kubeai.local
HARBOR_USERNAME=admin
HARBOR_PASSWORD=Harbor12345
HARBOR_PROJECT_PREFIX=kubeai-
