# Jupyter TensorFlow Notebook (GPU)
# Deep learning with TensorFlow + CUDA
#
# KubeAI platform-required JupyterHub pieces are already provided by
# quay.io/jupyter/tensorflow-notebook:
#   jupyterhub-singleuser, Jupyter Server, and JupyterLab are built in.
# This Dockerfile only adds optional project-specific tools.
#
# Build:
#   docker build -t kubeai-jupyter-tensorflow -f Dockerfile.tensorflow .

FROM quay.io/jupyter/tensorflow-notebook:cuda-latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    keras-tuner \
    tensorflow-datasets \
    tensorflow-hub \
    transformers \
    datasets \
    wandb \
    tensorboard \
    scikit-learn \
    optuna \
    plotly

RUN mkdir -p /workspace && chown ${NB_USER}:users /workspace

USER ${NB_UID}

EXPOSE 8888
