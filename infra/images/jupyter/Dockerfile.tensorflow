# Jupyter TensorFlow Notebook (GPU)
# Deep learning with TensorFlow + CUDA
#
# Native entrypoint — no JupyterHub dependency.
# The KubeAI backend runs "jupyter lab" directly on port 8888
# with --ServerApp.base_url set to the environment's path prefix.
#
# Build:
#   docker build -t kubeai-jupyter-tensorflow -f Dockerfile.tensorflow .

FROM quay.io/jupyter/tensorflow-notebook:cuda-latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    keras-tuner \
    tensorflow-datasets \
    tensorflow-hub \
    transformers \
    datasets \
    wandb \
    tensorboard \
    scikit-learn \
    optuna \
    plotly

USER ${NB_UID}

EXPOSE 8888
