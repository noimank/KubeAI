# Jupyter PyTorch Notebook (GPU)
# Deep learning with PyTorch + CUDA 12
#
# Native entrypoint — no JupyterHub dependency.
# The KubeAI backend runs "jupyter lab" directly on port 8888
# with --ServerApp.base_url set to the environment's path prefix.
#
# Build:
#   docker build -t kubeai-jupyter-pytorch -f Dockerfile.pytorch .

FROM quay.io/jupyter/pytorch-notebook:cuda12-latest

USER root

# 安装 uv（与 KubeAI 后端一致的 Python 包管理器）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN uv pip install --no-cache --system \
    torchvision \
    torchaudio \
    transformers \
    datasets \
    accelerate \
    wandb \
    tensorboard \
    scikit-learn \
    optuna \
    plotly \
    mlflow \
    onnx \
    onnxruntime \
    flask \
    fastapi

USER ${NB_UID}

EXPOSE 8888
