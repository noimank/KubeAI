# Jupyter PyTorch Notebook (CPU)
# Deep learning with PyTorch (CPU-only)
#
# ⚠️ 当前为 CPU 版本（部署机器无 GPU，镜像更轻量）。若机器配备 GPU，
#    需自行切换为 CUDA 基础镜像：
#      将下方 FROM 改为 quay.io/jupyter/pytorch-notebook:cuda12-latest
#
# Native entrypoint — runs directly on port 8888.
# The KubeAI backend runs "jupyter lab" directly on port 8888
# with --ServerApp.base_url set to the environment's path prefix.
#
# Build:
#   docker build -t hub.uimpcloud.com/kubeai/jupyter-env:pytorch -f Dockerfile.pytorch .

FROM quay.io/jupyter/pytorch-notebook:latest

USER root

# 安装 uv（与 KubeAI 后端一致的 Python 包管理器）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN uv pip install --no-cache --system \
    torchvision \
    torchaudio \
    transformers \
    datasets \
    accelerate \
    wandb \
    tensorboard \
    scikit-learn \
    neuralforecast \
    optuna \
    plotly \
    mlflow \
    onnx \
    onnxruntime \
    flask \
    fastapi

USER ${NB_UID}

EXPOSE 8888
