# Jupyter PyTorch Notebook (GPU)
# Deep learning with PyTorch + CUDA 12
#
# KubeAI platform-required JupyterHub pieces are already provided by
# quay.io/jupyter/pytorch-notebook:
#   jupyterhub-singleuser, Jupyter Server, and JupyterLab are built in.
# This Dockerfile only adds optional project-specific tools.
#
# Build:
#   docker build -t kubeai-jupyter-pytorch -f Dockerfile.pytorch .

FROM quay.io/jupyter/pytorch-notebook:cuda12-latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    torchvision \
    torchaudio \
    transformers \
    datasets \
    accelerate \
    wandb \
    tensorboard \
    scikit-learn \
    optuna \
    plotly

RUN mkdir -p /workspace && chown ${NB_USER}:users /workspace

USER ${NB_UID}

EXPOSE 8888
