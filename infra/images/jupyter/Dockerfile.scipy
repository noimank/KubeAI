# Jupyter SciPy Notebook (CPU)
# Scientific computing with NumPy, SciPy, Pandas, Matplotlib
#
# Native entrypoint — no JupyterHub dependency.
# The KubeAI backend runs "jupyter lab" directly on port 8888
# with --ServerApp.base_url set to the environment's path prefix.
#
# Build:
#   docker build -t kubeai-jupyter-scipy -f Dockerfile.scipy .
#   docker build -t hub.uimpcloud.com/kubeai/jupyter-scipy:latest -f Dockerfile.scipy .

FROM quay.io/jupyter/scipy-notebook:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    scikit-learn \
    xgboost \
    lightgbm \
    optuna \
    plotly \
    seaborn

USER ${NB_UID}

EXPOSE 8888
