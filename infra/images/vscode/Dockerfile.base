# VS Code Server (CPU)
# Lightweight code-server with Python and common extensions
#
# KubeAI runs VS Code through JupyterHub:
#   jupyterhub-singleuser is the required main process.
#   jupyter-server-proxy is required to proxy sub-applications.
#   jupyter-codeserver-proxy is required to expose code-server at /codeserver/.
#
# Build:
#   docker build -t kubeai-vscode-base -f Dockerfile.base .
#   docker build -t hub.uimpcloud.com/kubeai/vscode-base:latest -f Dockerfile.base .

FROM codercom/code-server:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# KubeAI platform-required dependencies:
#   jupyterhub: provides jupyterhub-singleuser for Hub-managed pods.
#   jupyter-server-proxy: integrates proxied apps with Jupyter Server auth/routing.
#   jupyter-codeserver-proxy: registers /codeserver/ and launches code-server.
RUN pip3 install --no-cache-dir --break-system-packages \
    jupyterhub \
    jupyter-server-proxy \
    jupyter-codeserver-proxy

# Optional data-science packages for the default VS Code image.
RUN pip3 install --no-cache-dir --break-system-packages \
    numpy \
    scipy \
    pandas \
    matplotlib \
    scikit-learn

RUN code-server --install-extension ms-python.python \
    && code-server --install-extension ms-toolsai.jupyter \
    && code-server --install-extension ms-azuretools.vscode-docker

RUN mkdir -p /workspace && chown coder:coder /workspace

# Required: clear code-server's default ENTRYPOINT so KubeSpawner can run jupyterhub-singleuser.
ENTRYPOINT []

USER coder

EXPOSE 8888
