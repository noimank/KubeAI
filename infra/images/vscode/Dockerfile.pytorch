# VS Code Server + PyTorch (GPU)
# Code-server with CUDA 12 + PyTorch for GPU-accelerated development
#
# KubeAI runs VS Code through JupyterHub:
#   jupyterhub-singleuser is the required main process.
#   jupyter-server-proxy is required to proxy sub-applications.
#   jupyter-codeserver-proxy is required to expose code-server at /codeserver/.
#
# Build:
#   docker build -t kubeai-vscode-pytorch -f Dockerfile.pytorch .

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://code-server.dev/install.sh | sh

# Optional ML stack for this GPU image.
RUN pip3 install --no-cache-dir --break-system-packages \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

# KubeAI platform-required dependencies:
#   jupyterhub: provides jupyterhub-singleuser for Hub-managed pods.
#   jupyter-server-proxy: integrates proxied apps with Jupyter Server auth/routing.
#   jupyter-codeserver-proxy: registers /codeserver/ and launches code-server.
RUN pip3 install --no-cache-dir --break-system-packages \
    jupyterhub jupyter-server-proxy jupyter-codeserver-proxy

# Optional data-science and experiment tooling.
RUN pip3 install --no-cache-dir --break-system-packages \
    numpy scipy pandas matplotlib scikit-learn \
    transformers datasets accelerate wandb \
    optuna plotly

RUN useradd -m -s /bin/bash -u 1000 coder

RUN code-server --install-extension ms-python.python \
    && code-server --install-extension ms-toolsai.jupyter

RUN mkdir -p /workspace && chown coder:coder /workspace

USER coder
WORKDIR /home/coder

EXPOSE 8888

# Required: clear ENTRYPOINT so KubeSpawner can run jupyterhub-singleuser.
ENTRYPOINT []
