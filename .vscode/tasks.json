{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend-dev",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "run-worker",
      "type": "shell",
      "command": "uv run taskiq worker app.core.taskiq_app:broker --fs-discover",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "run-beat",
      "type": "shell",
      "command": "uv run taskiq scheduler app.core.taskiq_app:scheduler --skip-first-run",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "frontend dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "frontend build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "database upgrade",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build and push images",
      "type": "shell",
      "command": "docker build -t hub.uimpcloud.com/kubeai/kubeai-backend:latest -f infra/images/backend/Dockerfile . && docker push hub.uimpcloud.com/kubeai/kubeai-backend:latest && docker build -t hub.uimpcloud.com/kubeai/kubeai-frontend:latest -f infra/images/frontend/Dockerfile . && docker push hub.uimpcloud.com/kubeai/kubeai-frontend:latest",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
          "args": ["-NoLogo", "-NoProfile", "-Command"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
